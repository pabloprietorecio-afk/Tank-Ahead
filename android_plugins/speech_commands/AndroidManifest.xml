<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pabloprieto.speech">

    <uses-sdk android:minSdkVersion="21" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+: sin esto el juego no "ve" el servicio de reconocimiento de voz del sistema. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application>
        <meta-data
            android:name="org.godotengine.plugin.v2.SpeechCommands"
            android:value="com.pabloprieto.speech.SpeechCommands" />
    </application>
</manifest>
